    \u091A\u0932\u0924\u0940 \u0939\u0948\u0902, \u091C\u094B \u092A\u0942\u0930\u0947
    \u0917\u094D\u0930\u0939 \u0915\u094B \u0922\u0915 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964\r\n"
