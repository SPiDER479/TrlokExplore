    \u0915\u0940 \u0924\u094D\u0930\u093F\u091C\u094D\u092F\u093E, 5.68 \xD7 10^26
    \u0915\u093F\u0932\u094B\u0917\u094D\u0930\u093E\u092E \u0915\u093E \u0926\u094D\u0930\u0935\u094D\u092F\u092E\u093E\u0928,
    \u0914\u0930 \u0938\u0942\u0930\u094D\u092F \u0938\u0947 1.43 \u0905\u0930\u092C
