  m_Script: {fileID: 11500000, guid: cb344f67ff6b253419e582a2acc4b42b, type: 3}
  m_Name: Neptune
  m_EditorClassIdentifier: Assembly-CSharp::TourDataSet
  english: "At the edge of the solar system lies Neptune. It has a radius of 24,622
    kilometers, a mass of 1.02 \xD7 10^26 kilograms, and orbits 4.5 billion kilometers
    from the Sun. Here, supersonic winds rage across a frozen, mysterious world.
    Together, these planets form our solar system \u2014 a delicate dance of gravity,
    time, and cosmic wonder."
  hindi: "\u0938\u094C\u0930\u092E\u0902\u0921\u0932 \u0915\u0947 \u0938\u092C\u0938\u0947
    \u092C\u093E\u0939\u0930\u0940 \u0915\u093F\u0928\u093E\u0930\u0947 \u092A\u0930
    \u0938\u094D\u0925\u093F\u0924 \u0939\u0948 \u0935\u0930\u0941\u0923 \u0917\u094D\u0930\u0939\u0964
    24,622 \u0915\u093F\u0932\u094B\u092E\u0940\u091F\u0930 \u0915\u0940 \u0924\u094D\u0930\u093F\u091C\u094D\u092F\u093E,
    1.02 \xD7 10^26 \u0915\u093F\u0932\u094B\u0917\u094D\u0930\u093E\u092E \u0915\u093E
    \u0926\u094D\u0930\u0935\u094D\u092F\u092E\u093E\u0928, \u0914\u0930 \u0938\u0942\u0930\u094D\u092F
    \u0938\u0947 4.5 \u0905\u0930\u092C \u0915\u093F\u0932\u094B\u092E\u0940\u091F\u0930
    \u0915\u0940 \u0926\u0942\u0930\u0940 \u092A\u0930 \u0938\u094D\u0925\u093F\u0924
    \u092F\u0939 \u0917\u094D\u0930\u0939 \u0924\u0940\u0935\u094D\u0930\u0924\u092E
    \u0939\u0935\u093E\u0913\u0902 \u0914\u0930 \u0930\u0939\u0938\u094D\u092F\u092E\u092F
    \u0935\u093E\u0924\u093E\u0935\u0930\u0923 \u0938\u0947 \u092D\u0930\u093E \u0939\u0941\u0906
    \u0939\u0948\u0964 \u092F\u0947 \u0938\u092D\u0940 \u0917\u094D\u0930\u0939 \u092E\u093F\u0932\u0915\u0930
    \u0939\u092E\u093E\u0930\u0947 \u0938\u094C\u0930\u092E\u0902\u0921\u0932 \u0915\u093E
    \u0928\u093F\u0930\u094D\u092E\u093E\u0923 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902
    \u2014 \u090F\u0915 \u0938\u0902\u0924\u0941\u0932\u093F\u0924, \u0930\u0939\u0938\u094D\u092F\u092E\u092F
    \u0914\u0930 \u0905\u0926\u094D\u092D\u0941\u0924 \u092C\u094D\u0930\u0939\u094D\u092E\u093E\u0902\u0921\u0940\u092F
    \u0928\u0943\u0924\u094D\u092F\u0964"
